{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yood",
  "version": "1.0.1",
  "identifier": "com.playrood.yood",
  "build": {
    "beforeDevCommand": "npm run build --prefix ../shared/frontend",
    "beforeBuildCommand": "npm run build --prefix ../shared/frontend",
    "frontendDist": "../../shared/frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**", "$DOWNLOAD/**", "$TEMP/**"] },
      "capabilities": ["default"]
    },
    "windows": []
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["yood"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "resources": [
      "binaries",
      "gstreamer",
      "../../shared/filters/default.txt",
      "../../shared/extension/yood/manifest.json",
      "../../shared/extension/yood/content.js",
      "../../shared/extension/yood/app-shell.js",
      "../../shared/extension/yood/app-icon.png",
      "../../shared/extension/yood/page.js",
      "../../shared/extension/yood/background.js",
      "../../shared/extension/yood/rules.json"
    ],
    "icon": ["icons/icon.svg", "icons/icon.png", "icons/icon.ico"]
  }
}
