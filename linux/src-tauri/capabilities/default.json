{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Yood desktop permissions",
  "windows":  ["main", "downloads"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "yood-app-commands"
  ],
  "remote": {
    "urls": ["https://*.youtube.com/*", "https://youtube.com/*"]
  }
}
